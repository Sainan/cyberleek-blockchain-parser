local { base64, http, json } = require "*"

local function time_to_iso8601(t)
	return os.date("!%Y-%m-%dT%H:%M:%S", t // 1)..tostring(t % 1):sub(2).."Z"
end

local function parse_leek(bin)
	local i = 0x29
	local timestamp, name, num_mirrors
	timestamp, name, num_mirrors, i ="<I8s4I4":unpack(bin, i)
	local mirrors = {}
	local leek = $object(name, timestamp, mirrors)
	for mirror_i = 1, num_mirrors do
		local mirror_name, mirror_link
		mirror_name, mirror_link, i = "<s4s4":unpack(bin, i)
		mirrors:insert({ name = mirror_name, link = mirror_link })
	end
	return leek
end

local function leek_to_string(leek)
	local str = leek.name.." - posted on "..time_to_iso8601(leek.timestamp)
	for leek.mirrors as mirror do
		str ..= "\n- "..mirror.name..": "..mirror.link
	end
	return str
end

local rpcs = {
	"https://solana.api.pocket.network/",
	"https://public.rpc.solanavibestation.com/",
	--"https://solana-rpc.publicnode.com/", -- Empty response
	--"https://solana-mainnet.gateway.tatum.io/", -- Method 'getProgramAccounts' is available for paid plans only.
	"https://api.mainnet.solana.com/",
}

while true do
	local rpc = rpcs[math.random(1, #rpcs)]
	local body--[[, status_code]] = http.request(rpc, {
		headers = {
			["Content-Type"] = "application/json"
		},
		body = "{\"method\":\"getProgramAccounts\",\"jsonrpc\":\"2.0\",\"params\":[\"7rAgHPLDc9NryZmNdeEzyDui6D9PHkvTxMjKhNSa7w3a\",{\"encoding\":\"base64\",\"commitment\":\"confirmed\",\"filters\":[{\"memcmp\":{\"offset\":0,\"bytes\":\"G6JNBZ2BSey\",\"encoding\":\"base58\"}},{\"dataSize\":7156}]}],\"id\":\"4a33fc01-c502-4302-aeca-5de7cac3eaa9\"}"
	})
	local data = json.decode(body or "")
	if not data then
		print("> Got invalid JSON from "..rpc..": "..tostring(body))
		--print(">> Status code: "..status_code) -- sometimes we get an empty body with 200 ...
	elseif not data.result then
		print("> Got an error from "..rpc..": "..body)
	else
		local leeks = data.result
		print("> Got "..#leeks.." leeks from "..rpc)
		leeks = leeks:map(|result| -> do
			assert(result.account.data[2] == "base64")
			return parse_leek(base64.decode(result.account.data[1]))
		end)
		leeks:sort(|a, b| -> a.timestamp < b.timestamp)
		for leeks as leek do
			print(leek_to_string(leek))
		end
		break
	end
	print("> Retrying in 3 seconds...")
	os.sleep(3000)
end
