local { base64, http, json } = require "*"
local { parse_announcement, rpcs } = require "libcyberleek"

while true do
	local rpc = rpcs[math.random(1, #rpcs)]
	local body--[[, status_code]] = http.request(rpc, {
		headers = {
			["Content-Type"] = "application/json"
		},
		body = "{\"method\":\"getProgramAccounts\",\"jsonrpc\":\"2.0\",\"params\":[\"7rAgHPLDc9NryZmNdeEzyDui6D9PHkvTxMjKhNSa7w3a\",{\"encoding\":\"base64\",\"commitment\":\"confirmed\",\"filters\":[{\"memcmp\":{\"offset\":0,\"bytes\":\"NjkxTouaByo\",\"encoding\":\"base58\"}},{\"dataSize\":656}]}],\"id\":\"b917eb52-2fc7-42c8-97d5-5ea54a56a634\"}"
	})
	local data = json.decode(body or "")
	if not data then
		print("> Got invalid JSON from "..rpc..": "..tostring(body))
		--print(">> Status code: "..status_code) -- sometimes we get an empty body with 200 ...
	elseif not data.result then
		print("> Got an error from "..rpc..": "..body)
	else
		local announcements = data.result
		print("> Got "..#announcements.." announcements from "..rpc)
		announcements = announcements:map(|result| -> do
			assert(result.account.data[2] == "base64")
			return parse_announcement(base64.decode(result.account.data[1]))
		end)
		announcements:sort(|a, b| -> a.timestamp < b.timestamp)
		print(dumpvar(announcements))
		break
	end
	print("> Retrying in 3 seconds...")
	os.sleep(3000)
end
